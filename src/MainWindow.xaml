<Window x:Class="StarRailCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarRailCompanion"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Star Rail Companion"
        Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStyle="None" AllowsTransparency="False" Background="#12131C"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Loaded="Window_Loaded" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- ================= STEP 1: THEME RESOURCES ================= -->
    <Window.Resources>
        <SolidColorBrush x:Key="GoldBrush"   Color="#E8C26A"/>
        <SolidColorBrush x:Key="MutedBrush"  Color="#8A8FA8"/>
        <SolidColorBrush x:Key="ErrorBrush"  Color="#FF7A7A"/>
        <SolidColorBrush x:Key="CardBrush"   Color="#1A1C2A"/>
        <SolidColorBrush x:Key="TrackBrush"  Color="#2A2D44"/>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#12131C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#B8BCD0"/>
            <Setter Property="Background" Value="#1A1C2A"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2D44"/>
                                <Setter Property="Foreground" Value="#E8C26A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#25283A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small flat icon button (header + folder button). Uses Segoe MDL2 Assets glyphs. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B8BCD0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2D44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stylised gold "Sync Warps" pill button -->
        <Style x:Key="SyncButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1424"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="17" Padding="22,8"
                                Background="{StaticResource GoldBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE29A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Coloured pill for the Discord / Ko-fi links in the title bar. Set Background on each button. -->
        <Style x:Key="LinkPillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="15" Height="30" Padding="14,0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ReleaseNoteTemplate" DataType="{x:Type local:ReleaseNote}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="4,0,4,8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="#E6E8F2" FontSize="14"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}" Foreground="#B8BCD0" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ================= STEP 2: PITY CARD TEMPLATE ================= -->
        <DataTemplate x:Key="BannerCardTemplate" DataType="{x:Type local:BannerStats}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Margin="6" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>

                    <!-- Big pity number -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Pity}" FontSize="58" FontWeight="Light"
                                   Foreground="{Binding PityBrush}"/>
                        <TextBlock Text="{Binding HardPity, StringFormat='/ {0}'}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="16"
                                   VerticalAlignment="Bottom" Margin="8,0,0,14"/>
                    </StackPanel>
                    <TextBlock Text="pulls since last 5★" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="2,-4,0,8"/>

                    <ProgressBar Height="8" Minimum="0"
                                 Maximum="{Binding HardPity}" Value="{Binding Pity, Mode=OneWay}"
                                 Foreground="{Binding Accent}" Background="{StaticResource TrackBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding StateText}" Foreground="#FFB454" FontSize="11"
                               Margin="0,6,0,0" MinHeight="16"/>

                    <!-- Pull counts and 4★/5★ history -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="4★ PITY" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                            <TextBlock Text="{Binding FourStarPity, StringFormat='{}{0} / 10'}"
                                       Foreground="#E6E8F2" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTAL PULLS" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                            <TextBlock Text="{Binding TotalPulls}" Foreground="#E6E8F2"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Text="4★ OBTAINED" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                            <TextBlock Text="{Binding FourStarCount}" Foreground="#E6E8F2"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                            <TextBlock Text="5★ OBTAINED" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                            <TextBlock Text="{Binding FiveStarCount}" Foreground="#E6E8F2"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="LAST 4★" Foreground="{StaticResource MutedBrush}"
                               FontSize="9.5" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding LastFourStar}" Foreground="#D7C7FF"
                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="LAST 5★" Foreground="{StaticResource MutedBrush}"
                               FontSize="9.5" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding LastFiveStar}" Foreground="{StaticResource GoldBrush}"
                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- ================= STEP 3: WINDOW LAYOUT ================= -->
    <Border x:Name="WindowFrame" CornerRadius="16" Background="#12131C"
            BorderBrush="#2A2D44" BorderThickness="1">
        <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar (drag to move) -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="✦" Foreground="{StaticResource GoldBrush}" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="STAR RAIL COMPANION" Foreground="#E6E8F2" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UidText" Text="UID —" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" Margin="14,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DiscordButton" Style="{StaticResource LinkPillButton}"
                            Background="#5865F2" Content="Discord"
                            ToolTip="Join the Discord community" Click="DiscordButton_Click"/>
                    <Button x:Name="KofiButton" Style="{StaticResource LinkPillButton}"
                            Background="#00B9FE" Content="&#x2665;  Ko-fi" Margin="0,0,14,0"
                            ToolTip="Support the project on Ko-fi" Click="KofiButton_Click"/>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                            ToolTip="Keep on top" Click="PinButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,8,0,0"
                        SelectionChanged="MainTabs_SelectionChanged">
                <TabItem x:Name="DashboardTab" Header="Dashboard">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="What's New" FontSize="24" FontWeight="SemiBold"
                                           Foreground="#E6E8F2"/>
                                <TextBlock x:Name="ReleaseNotesSubtitle"
                                           Text="Changes included in the latest release."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ReleaseNotesList"
                                              ItemTemplate="{StaticResource ReleaseNoteTemplate}"/>
                            </ScrollViewer>
                            <Border x:Name="ReleaseNotesStatusPanel" Background="#E612131C" Padding="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="10" MaxWidth="560">
                                <TextBlock Text="Release notes are not available."
                                           Foreground="#E6E8F2" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="NewsTab" Header="Game News">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="4,0,4,10">
                            <TextBlock DockPanel.Dock="Left" Text="Official Honkai: Star Rail News"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#E6E8F2"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="NewsBackButton" Content="Back" Padding="12,6"
                                        Margin="0,0,8,0" IsEnabled="False" Click="NewsBackButton_Click"/>
                                <Button x:Name="NewsRefreshButton" Content="Refresh" Padding="12,6"
                                        Margin="0,0,8,0" Click="NewsRefreshButton_Click"/>
                                <Button Content="Open in browser" Padding="12,6"
                                        Click="NewsOpenBrowserButton_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Background="#12131C">
                            <wv2:WebView2 x:Name="NewsWebView"/>
                            <Border x:Name="NewsStatusPanel" Background="#E612131C" Padding="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="10" MaxWidth="560">
                                <TextBlock x:Name="NewsStatusText"
                                           Text="The official news page will load when you open this tab."
                                           Foreground="#E6E8F2" TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="WarpTrackerTab" Header="Warps">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ItemsControl x:Name="CardsHost" Grid.Row="0" Margin="0,0,0,0"
                                      ItemTemplate="{StaticResource BannerCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Grid Grid.Row="1" Margin="6,6,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="FolderButton" Style="{StaticResource IconButton}" Content="&#xE838;"
                                        ToolTip="Set game folder manually" Click="FolderButton_Click" Margin="0,0,8,0"/>
                                <Button x:Name="SyncButton" Style="{StaticResource SyncButton}" Click="SyncButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,1,8,0"/>
                                        <TextBlock Text="Sync Warps"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TrailblazeTab" Header="Trailblaze &amp; Daily">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="4,0,4,14">
                            <TextBlock Text="Trailblaze &amp; Daily Dashboard" FontSize="24"
                                       FontWeight="SemiBold" Foreground="#E6E8F2"/>
                            <TextBlock Text="Sign in to HoYoLAB to load your Honkai: Star Rail real-time notes."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="4,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HoyolabSignInButton" Grid.Column="0" Content="Sign in to HoYoLAB"
                                    Padding="14,7" Click="HoyolabSignInButton_Click"/>
                            <ComboBox x:Name="HoyolabRoleSelector" Grid.Column="1" Margin="10,0"
                                      VerticalContentAlignment="Center" MinWidth="180"
                                      SelectionChanged="HoyolabRoleSelector_SelectionChanged"
                                      ToolTip="Select your Honkai: Star Rail account"/>
                            <Button x:Name="HoyolabLoadAccountsButton" Grid.Column="2"
                                    Content="Load accounts" Padding="14,7" Margin="0,0,8,0"
                                    Click="HoyolabLoadAccountsButton_Click"/>
                            <Button x:Name="HoyolabRefreshButton" Grid.Column="3"
                                    Content="Refresh notes" Padding="14,7"
                                    Click="HoyolabRefreshButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="HoyolabStatusText" Grid.Row="2" Text="Sign in with the HoYoLAB page below, then choose Load accounts."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="4,0,4,10"/>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="2">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="TRAILBLAZE POWER" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="TrailblazePowerText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="TrailblazeRecoveryText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="DAILY TRAINING" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="CommissionsText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="CommissionRewardText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="SIMULATED UNIVERSE" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="RealmCurrencyText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="RealmCurrencyRecoveryText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="EXPEDITIONS" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="ExpeditionsText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="ExpeditionsRecoveryText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Grid.Row="1" Text="Data is requested from HoYoLAB only when you choose to refresh. Login cookies remain in the encrypted WebView2 profile and are used transiently for the API request."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           FontSize="11" Margin="8,4"/>
                            </Grid>
                            <Border Grid.Column="1" Margin="4" CornerRadius="10"
                                    BorderBrush="#2A2D44" BorderThickness="1">
                                <Grid>
                                    <wv2:WebView2 x:Name="HoyolabAuthView" Visibility="Collapsed"/>
                                    <TextBlock x:Name="HoyolabAuthPlaceholder"
                                               Text="HoYoLAB sign-in opens here after you click “Sign in to HoYoLAB”."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               TextAlignment="Center" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="24"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="InteractiveMapTab" Header="Interactive Map">
                    <Grid Background="#12131C">
                        <wv2:WebView2 x:Name="InteractiveMap"/>
                        <Border x:Name="MapStatusPanel" Background="#E612131C" Padding="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="10" MaxWidth="560">
                            <StackPanel>
                                <TextBlock x:Name="MapStatusText" Text="The map will load when you open this tab."
                                           Foreground="#E6E8F2" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <Button x:Name="MapOpenBrowserButton" Content="Open map in browser"
                                        HorizontalAlignment="Center" Padding="12,6" Visibility="Collapsed"
                                        Click="MapOpenBrowserButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="BuildEvaluatorTab" Header="Builds">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="4,0,4,14">
                            <TextBlock Text="Character Showcase" FontSize="24"
                                       FontWeight="SemiBold" Foreground="#E6E8F2"/>
                            <TextBlock Text="Look up your public Honkai: Star Rail character showcase on Enka.Network."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="4,0,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BuildUidInput" Grid.Column="0" MaxLength="9"
                                     VerticalContentAlignment="Center" Padding="10,8"
                                     FontSize="14" Background="{StaticResource CardBrush}"
                                     Foreground="#E6E8F2" BorderBrush="#2A2D44"
                                     ToolTip="Enter your 9-digit public Honkai: Star Rail UID"
                                     KeyDown="BuildUidInput_KeyDown"/>
                            <Button x:Name="BuildLookupButton" Grid.Column="1" Content="Load Showcase"
                                    Padding="14,7" Margin="8,0,0,0" Click="BuildLookupButton_Click"/>
                            <Button Grid.Column="2" Content="Use saved UID" Padding="14,7"
                                    Margin="8,0,0,0" Click="UseSavedUid_Click"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <wv2:WebView2 x:Name="BuildWebView"/>
                            <Border x:Name="BuildStatusPanel" Background="#E612131C" Padding="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="10" MaxWidth="560">
                                <StackPanel>
                                    <TextBlock x:Name="BuildStatusText"
                                               Text="Enter a 9-digit UID to view its public Honkai: Star Rail Enka.Network showcase."
                                               Foreground="#E6E8F2" TextWrapping="Wrap" TextAlignment="Center"
                                               Margin="0,0,0,12"/>
                                    <Button x:Name="BuildOpenBrowserButton" Content="Open showcase in browser"
                                            HorizontalAlignment="Center" Padding="12,6"
                                            Visibility="Collapsed" Click="BuildOpenBrowserButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="StellarJadePlannerTab" Header="Stellar Jade Planner">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="4,0,4,16">
                                <TextBlock Text="Stellar Jade Warp Planner" FontSize="24" FontWeight="SemiBold"
                                           Foreground="#E6E8F2"/>
                                <TextBlock Text="Estimate the chance to obtain your target featured 5★ with your current savings."
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="AVAILABLE WARPS" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PlannerAvailableWarps" Text="0" Foreground="#E6E8F2"
                                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="FEATURED 5★ CHANCE" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PlannerChance" Text="0%" Foreground="#59D98E"
                                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PlannerGuaranteeCard" Background="#1A1C2A"
                                        CornerRadius="12" Margin="5" Padding="15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="WARPS TILL GUARANTEED" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PlannerGuaranteePulls" Text="—" Foreground="#E6E8F2"
                                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <Border x:Name="PlannerGuaranteedBadge" Background="#254B3A"
                                                CornerRadius="10" Padding="9,3" Margin="0,5,0,0"
                                                Visibility="Collapsed">
                                            <TextBlock Text="Guaranteed Secured!" Foreground="#8DE0B0"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="2" Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                                        CornerRadius="12" Margin="0,0,6,0" Padding="18">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Stellar Jade stash" Foreground="#E6E8F2"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PlannerJadesValue" Text="0 Stellar Jade"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                        <Slider x:Name="PlannerJadesSlider" Minimum="0" Maximum="32000"
                                                Value="0" TickFrequency="160" IsSnapToTickEnabled="True"
                                                ValueChanged="PlannerInput_ValueChanged"/>
                                        <TextBlock Text="Special Passes" Foreground="#E6E8F2"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="PlannerSpecialPassesValue" Text="0 Passes"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                        <Slider x:Name="PlannerSpecialPassesSlider" Minimum="0" Maximum="200"
                                                Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="PlannerInput_ValueChanged"/>
                                        <TextBlock Text="Current pity" Foreground="#E6E8F2"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="PlannerPityValue" Text="0 / 90"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                        <Slider x:Name="PlannerPitySlider" Minimum="0" Maximum="89"
                                                Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="PlannerInput_ValueChanged"/>
                                        <CheckBox x:Name="PlannerGuaranteedCheckBox"
                                                  Content="Featured 5★ is guaranteed"
                                                  Foreground="#E6E8F2" Margin="0,12,0,0"
                                                  Checked="PlannerInput_Changed"
                                                  Unchecked="PlannerInput_Changed"/>
                                        <TextBlock x:Name="PlannerHistoryStatus"
                                                  Text="Pity and guarantee load from your saved Warp history."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{StaticResource CardBrush}"
                                        CornerRadius="12" Margin="6,0,0,0" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="4,0,4,8">
                                            <TextBlock Text="Character Event Warp 5★ Pity Curve"
                                                       Foreground="#E6E8F2" FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Soft pity starts at pull 74 · hard pity at 90"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Canvas x:Name="PlannerPityChart" Grid.Row="1" Height="250"
                                                SizeChanged="PlannerPityChart_SizeChanged"
                                                ClipToBounds="True"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="PlannerChanceBar" Grid.Row="3" Minimum="0" Maximum="100"
                                         Height="10" Margin="6,10,6,4" Foreground="#3978FF"
                                         Background="{StaticResource TrackBrush}" BorderThickness="0"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="SupportTab" Header="Support">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*" MinWidth="340"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0,14,0">
                                <TextBlock Text="Support Star Rail Companion" FontSize="24"
                                           FontWeight="SemiBold" Foreground="#E6E8F2"/>
                                <TextBlock Text="Star Rail Companion is a community-made, ad-free tool. Your support helps fund development, bug fixes, and new features without relying on ads or paywalls."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,4,0,16"/>

                                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                        Margin="0,0,0,10" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Feature Development &amp; Maintenance"
                                                   Foreground="#E6E8F2" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="- Funds rapid bug fixes: Keeps me on top of sudden API changes or game patch updates so the app never stays broken.&#xA;&#xA;- Fuel for new features: Directly buys time for complex additions like advanced analytics, interactive maps, or customized planner tools.&#xA;&#xA;- Rigorous optimization: Allows me to spend dedicated hours making sure the app stays lightweight, lightning-fast, and easy on your system resources."
                                                   Foreground="#B8BCD0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                        Margin="0,0,0,10" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Project Integrity &amp; Independence"
                                                   Foreground="#E6E8F2" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="- Guarantees a 100% ad-free experience: Keeps the UI clean and beautiful without ever resorting to annoying pop-ups or clunky banners.&#xA;&#xA;- Protects user privacy: Ensures the app remains completely untracked, open-source, and free from any third-party data scraping.&#xA;&#xA;- Covers code signing and distribution: Helps fund developer certificates and secure delivery pipelines so your system installer stays safe, clean, and trusted."
                                                   Foreground="#B8BCD0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                        Margin="0,0,0,18" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Long-Term Vision &amp; Growth"
                                                   Foreground="#E6E8F2" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="- Scales infrastructure capacity as more Trailblazers join the community.&#xA;&#xA;- Supports long-term maintenance and new features.&#xA;&#xA;- Helps keep the project independent, ad-free, and open-source."
                                                   Foreground="#B8BCD0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource SyncButton}" HorizontalAlignment="Left"
                                        Click="KofiButton_Click">
                                    <TextBlock Text="&#x2665;  Support on Ko-fi"/>
                                </Button>
                                <TextBlock Text="Thank you for being part of the project."
                                           Foreground="{StaticResource MutedBrush}" Margin="2,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="1" Margin="4" CornerRadius="10"
                                BorderBrush="#2A2D44" BorderThickness="1">
                            <Grid Background="#12131C">
                                <wv2:WebView2 x:Name="SupportWebView"/>
                                <Border x:Name="SupportStatusPanel" Background="#E612131C" Padding="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="10" MaxWidth="360">
                                    <TextBlock x:Name="SupportStatusText"
                                               Text="The Ko-fi widget loads when you open this tab."
                                               Foreground="#E6E8F2" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
